#include<stdio.h>

int long long fact(int n){
    if(n==0||n==1){
        return 1;
    }else{
        return n*fact(n-1);
    }
}
int main(){
    int n;
    printf("enter a number:");
    scanf("%d",&n);
    printf("factorial= %d",fact(n));
    return 0;
}

