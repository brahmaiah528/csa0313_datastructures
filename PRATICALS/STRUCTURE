#include <stdio.h>
#include <string.h>

struct Student {
    int rollno;
    char name[50];
    int marks;
};

int main() {
    int n, i;
    scanf("%d", &n);

    struct Student s[100];

    for (i = 0; i < n; i++) {
        scanf("%d %s %d", &s[i].rollno, s[i].name, &s[i].marks);
    }

    int maxMark = s[0].marks;
    int maxIndex = 0;
    float total = 0;

    for (i = 0; i < n; i++) {
        total += s[i].marks;
        if (s[i].marks > maxMark) {
            maxMark = s[i].marks;
            maxIndex = i;
        }
    }

    FILE *fp = fopen("students.txt", "w");
    if (fp != NULL) {
        for (i = 0; i < n; i++) {
            fprintf(fp, "%d %s %d\n", s[i].rollno, s[i].name, s[i].marks);
        }
        fclose(fp);
    }

    printf("Highest Mark: %d (%s)\n", s[maxIndex].marks, s[maxIndex].name);
    printf("Class Average: %.2f\n", total / n);
    printf("%d records stored successfully.", n);

    return 0;
}
