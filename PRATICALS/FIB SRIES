#include <stdio.h>
#include <time.h>

long long recursiveCalls = 0;

long long fib_recursive(int n) {
    recursiveCalls++;
    if (n == 0) return 0;
    if (n == 1) return 1;
    return fib_recursive(n - 1) + fib_recursive(n - 2);
}

void fib_iterative(int n) {
    long long a = 0, b = 1, c;
    for (int i = 0; i < n; i++) {
        if (i == 0) printf("%lld", a);
        else if (i == 1) printf("%lld", b);
        else {
            c = a + b;
            printf("%lld", c);
            a = b;
            b = c;
        }
        if (i != n - 1) printf(" ");
    }
    printf("\n");
}

int main() {
    int N;
    printf("Enter N: ");
    if (scanf("%d", &N) != 1 || N <= 0) {
        printf("Invalid N\n");
        return 0;
    }

    clock_t start = clock();
    printf("Iterative: ");
    fib_iterative(N);
    clock_t end = clock();
    double time_iterative = ((double)(end - start)) / CLOCKS_PER_SEC * 1000;

    start = clock();
    printf("Recursive: ");
    for (int i = 0; i < N; i++) {
        printf("%lld", fib_recursive(i));
        if (i != N - 1) printf(" ");
    }
    printf("\n");
    end = clock();
    double time_recursive = ((double)(end - start)) / CLOCKS_PER_SEC * 1000;

    printf("Recursive Calls: %lld\n", recursiveCalls);
    printf("Iterative Time: %.3f ms\n", time_iterative);
    printf("Recursive Time: %.3f ms\n", time_recursive);

    return 0;
}
