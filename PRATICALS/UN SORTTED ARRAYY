#include <stdio.h>

int main() {
    int n;
    scanf("%d", &n);
    int a[n];
    int min, max;
    for (int i = 0; i < n; i++) {
        scanf("%d", &a[i]);
        if (i == 0) {
            min = max = a[i];
        } else {
            if (a[i] < min) min = a[i];
            if (a[i] > max) max = a[i];
        }
    }
    int size = max - min + 1;
    int present[size];
    for (int i = 0; i < size; i++) present[i] = 0;

    for (int i = 0; i < n; i++) {
        present[a[i] - min] = 1;
    }
    int firstPrinted = 0;
    for (int val = min; val <= max; val++) {
        if (present[val - min] == 0) {
            if (firstPrinted) printf(",");
            printf("%d", val);
            firstPrinted = 1;
        }
    }
    return 0;
}
