#include <stdio.h>

int main() {
    int n, a[100];
    printf("Enter number of elements: ");
    scanf("%d", &n);
    if (n < 5) {
        printf("Array must have at least 5 elements.\n");
        return 0;
    }
    printf("Enter array elements:\n");
    for (int i = 0; i < n; i++) {
        scanf("%d", &a[i]);
    }
    printf("5th element = %d", a[4]);
    return 0;
}
