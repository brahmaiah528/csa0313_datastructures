#include <stdio.h>

typedef struct {
    int row;
    int col;
    int val;
} Triple;

int main() {
    int r1, c1, t1;
    int r2, c2, t2;

    scanf("%d %d %d", &r1, &c1, &t1);
    Triple A[100];
    int nA = t1;
    for (int i = 0; i < t1; i++) 
        scanf("%d %d %d", &A[i].row, &A[i].col, &A[i].val);

    scanf("%d %d %d", &r2, &c2, &t2);
    Triple B[100];
    int nB = t2;
    for (int i = 0; i < t2; i++) 
        scanf("%d %d %d", &B[i].row, &B[i].col, &B[i].val);

    Triple R[200];
    int nR = 0;
    int i = 0, j = 0;

    while (i < nA && j < nB) {
        if (A[i].row < B[j].row || (A[i].row == B[j].row && A[i].col < B[j].col)) {
            if (A[i].val != 0) R[nR++] = A[i];
            i++;
        } else if (B[j].row < A[i].row || (B[j].row == A[i].row && B[j].col < A[i].col)) {
            if (B[j].val != 0) R[nR++] = B[j];
            j++;
        } else {
            int sum = A[i].val + B[j].val;
            if (sum != 0) {
                R[nR].row = A[i].row;
                R[nR].col = A[i].col;
                R[nR].val = sum;
                nR++;
            }
            i++;
            j++;
        }
    }

    while (i < nA) {
        if (A[i].val != 0) R[nR++] = A[i];
        i++;
    }

    while (j < nB) {
        if (B[j].val != 0) R[nR++] = B[j];
        j++;
    }

    int dense[10][10] = {0};
    for (int k = 0; k < nR; k++) {
        dense[R[k].row][R[k].col] = R[k].val;
    }

    for (int r = 0; r < r1; r++) {
        for (int c = 0; c < c1; c++) {
            printf("%d", dense[r][c]);
            if (c < c1 - 1) printf(" ");
        }
        printf("\n");
    }

    return 0;
}

