Q1. Reverse a list
Code
#include<stdio.h>
int main() {
    int n, i;
    printf("Enter the number of elements: ");
    scanf("%d", &n);
    int arr[n];
    printf("Enter %d elements: ", n);
    for(i = 0; i < n; i++) {
        scanf("%d", &arr[i]);
    }
    int start = 0, end = n - 1;
    while(start < end) {
        int temp = arr[start];
        arr[start] = arr[end];
        arr[end] = temp;
        start++;
        end--;
    }
    printf("Reversed array: ");
    for(i = 0; i < n; i++) {
        printf("%d ", arr[i]);
    }
    printf("\n");
    
    return 0;
}
Input
5
4 5 9 8 6
Output
Enter the number of elements: Enter 5 elements: Reversed array: 6 8 9 5 4 

Q2. Reverse a string
Code
#include <stdio.h>
#include <string.h>
int main() {
    char s[200];
    int i, n, flag = 1;
    scanf("%[^\n]s", s);
    n = strlen(s);
    for (i = 0; i < n / 2; i++) {
        if (s[i] != s[n - 1 - i]) {
            flag = 0;
            break;
        }
    }
    if (flag)
        printf("Palindrome");
    else
        printf("Not Palindrome");
    return 0;
}
Input
12321
Output
Palindrome
