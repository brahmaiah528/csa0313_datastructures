Q5. Array
Code
#include <stdio.h>
int main() {
    int n, i, key;
    scanf("%d", &n);
    int a[n];
    for (i = 0; i < n; i++) {
        scanf("%d", &a[i]);
    }
    scanf("%d", &key);
    int low = 0, high = n - 1;
    int found = -1;
    while (low <= high) {
        int mid = low + (high - low) / 2;
        if (a[mid] == key) {
            found = mid;
            break;
        } else if (a[mid] < key) {
            low = mid + 1;
        } else {
            high = mid - 1;
        }
    }
    if (found != -1)
        printf("Found at index %d", found);
    else
        printf("Not Found");
    return 0;
}
Input
5
10 20 30 40 50
30
Output
Found at index 2
Q6. Merging
Code
#include <stdio.h>
int main() {
    int n, m;
    printf("Enter size of first array: ");
    scanf("%d", &n);    
    printf("Enter size of second array: ");
    scanf("%d", &m);
    int a[n], b[m];
    int merged[n + m];
    printf("Enter elements of first sorted array:\n");
    for (int i = 0; i < n; i++) {
        scanf("%d", &a[i]);
    }
    printf("Enter elements of second sorted array:\n");
    for (int i = 0; i < m; i++) {
        scanf("%d", &b[i]);
    }
    int i = 0, j = 0, k = 0;
    while (i < n && j < m) {
        if (a[i] <= b[j]) {
            merged[k++] = a[i++];
        } else {
            merged[k++] = b[j++];
        }
    }
    while (i < n) {
        merged[k++] = a[i++];
    }
    while (j < m) {
        merged[k++] = b[j++];
    }
    printf("Merged array:\n");
    for (int t = 0; t < n + m; t++) {
        printf("%d ", merged[t]);
    }
    return 0;
}
